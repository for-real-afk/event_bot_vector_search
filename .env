# ── Pinecone (get free API key at https://app.pinecone.io) ───────────────
PINECONE_API_KEY=
PINECONE_INDEX=attendees
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── Embedding (runs locally, no key needed) ──────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_SIZE=384
SCORE_THRESHOLD=0.25

# ── Groq — query expansion only ──────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_QUERY_EXPANSION=true

# Prod: point at your EC2 Gemma instead
# GROQ_BASE_URL=http://<EC2-IP>:11434/v1
# GROQ_MODEL=gemma3:27b
# GROQ_API_KEY=ollama

# ── App ──────────────────────────────────────────────────────────────────
DEBUG=false
